<% var active = 'sliders'; var pageTitle = 'Promo Sliders'; %>
<% var scripts = ''; %>
<%
var slidersHtml = '';
var storeList = typeof stores !== 'undefined' && stores ? stores : [];
function destinoFields(current) {
  var cur = current || '';
  var curSlug = '';
  if (cur.indexOf('/store/') === 0) { try { curSlug = decodeURIComponent(cur.slice(7)); } catch (e) { curSlug = cur.slice(7); } }
  var opts = '<option value="">— Sin tienda —</option>';
  storeList.forEach(function(st) {
    opts += `<option value="${esc(st.slug)}" ${st.slug === curSlug ? 'selected' : ''}>${esc(st.name)}</option>`;
  });
  var otherUrl = curSlug && storeList.some(function(st) { return st.slug === curSlug; }) ? '' : cur;
  return `<div class="form-group"><label>Tienda destino (al tocar el slider)</label><select name="store_slug" class="form-control">${opts}</select></div>
    <div class="form-group"><label>O enlace (https://... o ruta de la app, ej. /explore)</label><input type="text" name="url" class="form-control" maxlength="255" value="${esc(otherUrl)}"><small class="form-text text-muted">Si eliges una tienda, se usa la tienda.</small></div>`;
}

// Edit form if editing
if (typeof editSlider !== 'undefined' && editSlider) {
  slidersHtml += `
  <div class="card mb-3" style="border:2px solid var(--primary)">
    <div class="card-header">Editar Slider: <strong>${esc(editSlider.name)}</strong></div>
    <div class="card-body">
      <form method="POST" action="/admin/slider/edit/save" enctype="multipart/form-data">
        <input type="hidden" name="id" value="${esc(editSlider.id)}">
        <div class="row">
          <div class="col-md-6">
            <div class="form-group"><label>Name *</label><input type="text" name="name" class="form-control" value="${esc(editSlider.name)}" required></div>
            <div class="form-group"><label>Image</label><input type="file" name="image" class="form-control-file" accept="image/*">${editSlider.image ? `<img src="${esc(editSlider.image)}" width="120" class="mt-2" style="border-radius:6px">` : ''}</div>
          </div>
          <div class="col-md-6">
            <div class="form-group"><label>Position</label><select name="position_id" class="form-control"><option value="0" ${esc(editSlider.position_id==0?'selected':'')}>Main</option><option value="1" ${esc(editSlider.position_id==1?'selected':'')}>Top</option><option value="2" ${esc(editSlider.position_id==2?'selected':'')}>Bottom</option></select></div>
            <div class="form-group"><label>Size</label><select name="size" class="form-control"><option value="0" ${esc(editSlider.size==0?'selected':'')}>Default</option><option value="1" ${esc(editSlider.size==1?'selected':'')}>Small</option><option value="2" ${esc(editSlider.size==2?'selected':'')}>Large</option></select></div>
            ${destinoFields(editSlider.url)}
          </div>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
        <a href="/admin/promo-sliders" class="btn btn-secondary ml-2">Cancelar</a>
      </form>
    </div>
  </div>`;
}

if (typeof sliders !== 'undefined' && sliders.length) {
  sliders.forEach(function(s) {
    var slidesHtml = '';
    if (s.slides && s.slides.length) {
      s.slides.forEach(function(slide) {
        var imgTag = slide.image ? `<img src="${esc(slide.image)}" class="img-fluid rounded" style="max-height:100px">` : '';
        slidesHtml += `<div class="col-md-3 mb-2">${imgTag}<small class="d-block mt-1">${esc(slide.name || 'Slide')}</small>
          <form method="POST" action="/admin/slider/${esc(s.id)}/slide/delete/${esc(slide.id)}" class="d-inline" data-confirm="Eliminar slide?"><button type="submit" class="btn btn-sm btn-outline-danger mt-1"><i class="fas fa-trash"></i></button></form></div>`;
      });
    } else {
      slidesHtml = '<div class="col-12"><p class="text-muted">No slides yet</p></div>';
    }
    slidersHtml += `
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><strong>${esc(s.name)}</strong></span>
        <div>
          <a href="/admin/slider/edit/${esc(s.id)}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
          <form method="POST" action="/admin/slider/delete/${esc(s.id)}" class="d-inline" data-confirm="Eliminar slider?"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form>
        </div>
      </div>
      <div class="card-body">
        ${s.image ? `<div class="mb-2"><img src="${esc(s.image)}" class="img-fluid rounded" style="max-height:120px"></div>` : '<p class="text-muted">Sin imagen</p>'}
        <small class="d-block mb-2 text-muted">Destino: ${esc(s.url || 'ninguno')}</small>
        <div class="row">${slidesHtml}</div>
        <form method="POST" action="/admin/slider/${esc(s.id)}/slide/create" enctype="multipart/form-data" class="mt-3 border-top pt-3">
          <div class="row">
            <div class="col-md-3"><div class="form-group"><label>Slide: nombre</label><input type="text" name="name" class="form-control" maxlength="255"></div></div>
            <div class="col-md-3"><div class="form-group"><label>Imagen *</label><input type="file" name="image" class="form-control-file" accept="image/*" required></div></div>
            <div class="col-md-2"><div class="form-group"><label>Orden</label><input type="number" name="sort_position" class="form-control" value="0"></div></div>
            <div class="col-md-4">${destinoFields('')}</div>
          </div>
          <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Agregar slide</button>
        </form>
      </div>
    </div>`;
  });
} else {
  slidersHtml = '<p class="text-muted text-center py-4">No sliders found</p>';
}

var body = `
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Promo Sliders (${esc(typeof count !== 'undefined' ? count : 0)})</span>
        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#newSliderModal"><i class="fas fa-plus"></i> New Slider</button>
    </div>
    <div class="card-body">${slidersHtml}</div>
</div>

<div class="modal fade" id="newSliderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/slider/create" enctype="multipart/form-data">
                <div class="modal-header"><h5>New Slider</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="form-group"><label>Name *</label><input type="text" name="name" class="form-control" required></div>
                    <div class="form-group"><label>Image *</label><input type="file" name="image" class="form-control-file" accept="image/*" required></div>
                    <div class="form-group"><label>Position</label><select name="position_id" class="form-control"><option value="0">Main</option><option value="1">Top</option><option value="2">Bottom</option></select></div>
                    <div class="form-group"><label>Size</label><select name="size" class="form-control"><option value="0">Default</option><option value="1">Small</option><option value="2">Large</option></select></div>
                    ${destinoFields('')}
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Create Slider</button></div>
            </form>
        </div>
    </div>
</div>`;
%>
<%- include('./layouts/master', { body, active, pageTitle, user: typeof user !== 'undefined' ? user : null, success: typeof success !== 'undefined' ? success : null, error: typeof error !== 'undefined' ? error : null, message: typeof message !== 'undefined' ? message : null, scripts }) %>
