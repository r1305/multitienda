<% var active = 'dashboard'; var pageTitle = 'Dashboard'; %>
<%
var currency = typeof settings !== 'undefined' && settings && settings.currencySymbol ? settings.currencySymbol : '$';
var elapsedFn = typeof formatOrderElapsed === 'function' ? formatOrderElapsed : function() { return '-'; };

var scripts = `
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
let earningsChart = null;

function loadChart(filter) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  document.querySelector('[data-filter="'+filter+'"]').classList.add('active');
  const customEl = document.getElementById('customRange');
  if (filter === 'custom') {
    customEl.style.display = 'flex';
    if (!document.getElementById('dateFrom').value) document.getElementById('dateFrom').value = new Date().toISOString().split('T')[0];
    if (!document.getElementById('dateTo').value) document.getElementById('dateTo').value = new Date().toISOString().split('T')[0];
  } else { customEl.style.display = 'none'; }

  let url = '/admin/api/earnings-chart?filter=' + filter;
  if (filter === 'custom') {
    const from = document.getElementById('dateFrom').value;
    const to = document.getElementById('dateTo').value;
    if (!from || !to) return;
    url += '&from=' + from + '&to=' + to;
  }

  fetch(url).then(r => r.json()).then(data => {
    const ctx = document.getElementById('earningsChart').getContext('2d');
    if (earningsChart) earningsChart.destroy();
    const T = window.adminChartTheme();
    const gridColor = T.grid;
    const textColor = T.text;
    earningsChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: data.labels,
        datasets: [{
          label: 'Ganancias',
          data: data.values,
          borderColor: T.line,
          backgroundColor: T.fill,
          fill: true,
          tension: 0.4,
          pointRadius: 3,
          pointBackgroundColor: T.line,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : { duration: 600 },
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: textColor, callback: v => '${esc(currency)}' + v } },
          x: { grid: { display: false }, ticks: { color: textColor } }
        }
      }
    });
    document.getElementById('totalEarnings').textContent = '${esc(currency)}' + data.total.toFixed(2);
  });
}

document.addEventListener('DOMContentLoaded', function() { loadChart('week'); refreshOrderElapsedCells(); setInterval(refreshOrderElapsedCells, 30000); });
document.addEventListener('admin:theme', function() { var b = document.querySelector('.filter-btn.active'); loadChart(b ? b.dataset.filter : 'week'); });

window.formatOrderElapsed = function(createdAt, statusId, updatedAt) {
  if (!createdAt) return '-';
  var start = new Date(createdAt).getTime();
  if (isNaN(start)) return '-';
  var sid = parseInt(statusId, 10);
  var end = Date.now();
  if ((sid === 5 || sid === 6) && updatedAt) {
    var u = new Date(updatedAt).getTime();
    if (!isNaN(u)) end = u;
  }
  var ms = Math.max(0, end - start);
  var mins = Math.floor(ms / 60000);
  if (mins < 1) return '< 1 min';
  if (mins < 60) return mins + ' min';
  var hours = Math.floor(mins / 60), rm = mins % 60;
  if (hours < 24) return rm ? hours + ' h ' + rm + ' min' : hours + ' h';
  var days = Math.floor(hours / 24), rh = hours % 24;
  return rh ? days + ' d ' + rh + ' h' : days + ' d';
};
function refreshOrderElapsedCells() {
  document.querySelectorAll('[data-order-elapsed]').forEach(function(el) {
    el.textContent = formatOrderElapsed(el.dataset.created, el.dataset.status, el.dataset.updated || '');
  });
}

function statusBadge(id) {
  const map = {1:'info',2:'warning',3:'warning',4:'warning',5:'success',6:'danger',7:'success',8:'secondary',9:'danger',10:'purple',11:'info',12:'warning'};
  return map[id] || 'secondary';
}
function statusText(id) {
  const map = {1:'Nuevo',2:'Aceptado',3:'En delivery',4:'En camino',5:'Entregado',6:'Cancelado',7:'Listo',8:'Pago pend.',9:'Pago fallido',10:'Programado',11:'Confirmado',12:'En preparación'};
  return map[id] || '-';
}
</script>`;

var body = `
<!-- Welcome & Today Summary -->
<div class="row align-items-center mb-3">
  <div class="col">
    <h4 class="welcome-title">Bienvenido, ${esc(typeof user !== 'undefined' && user ? user.name : 'Admin')}</h4>
    <p class="text-muted mb-0" style="font-size:13px">Resumen general de tu plataforma</p>
  </div>
  <div class="col-auto">
    <span class="badge badge-light" style="font-size:12px;padding:8px 12px"><i class="fas fa-calendar-day mr-1"></i> ${esc(new Date().toLocaleDateString('es', { weekday:'long', day:'numeric', month:'long' }))}</span>
  </div>
</div>

<!-- Today Highlight -->
<div class="row mb-3">
  <div class="col-md-4">
    <div class="card stat-card blue">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon blue"><i class="fas fa-shopping-bag"></i></div>
        <div><h4 class="mb-0" style="font-size:20px;font-weight:700">${esc(typeof stats !== 'undefined' ? stats.todayOrders : 0)}</h4><small class="text-muted">Pedidos hoy</small></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card green">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
        <div><h4 class="mb-0" style="font-size:20px;font-weight:700">${esc(currency)} ${esc(typeof stats !== 'undefined' ? parseFloat(stats.todayRevenue).toFixed(2) : '0.00')}</h4><small class="text-muted">Ingresos hoy</small></div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card purple">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon purple"><i class="fas fa-coins"></i></div>
        <div><h4 class="mb-0" style="font-size:20px;font-weight:700">${esc(currency)} ${esc(typeof stats !== 'undefined' ? parseFloat(stats.totalRevenue).toFixed(2) : '0.00')}</h4><small class="text-muted">Ingresos totales</small></div>
      </div>
    </div>
  </div>
</div>

<!-- Stats Grid -->
<div class="row mb-3">
  <div class="col-6 col-lg-3">
    <div class="card stat-card blue">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon blue"><i class="fas fa-receipt"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.totalOrders : 0)}</h5><small class="text-muted">Total pedidos</small></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card orange">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon orange"><i class="fas fa-clock"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.pendingOrders : 0)}</h5><small class="text-muted">Pendientes</small></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card green">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.completedOrders : 0)}</h5><small class="text-muted">Completados</small></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card stat-card red">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon red"><i class="fas fa-times-circle"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.cancelledOrders : 0)}</h5><small class="text-muted">Cancelados</small></div>
      </div>
    </div>
  </div>
</div>

<!-- Platform Stats -->
<div class="row mb-3">
  <div class="col-4">
    <div class="card stat-card teal">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon teal"><i class="fas fa-users"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.totalUsers : 0)}</h5><small class="text-muted">Usuarios</small></div>
      </div>
    </div>
  </div>
  <div class="col-4">
    <div class="card stat-card orange">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon orange"><i class="fas fa-store"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.totalStores : 0)}</h5><small class="text-muted">Tiendas</small></div>
      </div>
    </div>
  </div>
  <div class="col-4">
    <div class="card stat-card blue">
      <div class="card-body d-flex align-items-center gap-3 py-3">
        <div class="stat-icon blue"><i class="fas fa-motorcycle"></i></div>
        <div><h5 class="mb-0" style="font-weight:700">${esc(typeof stats !== 'undefined' ? stats.totalDelivery : 0)}</h5><small class="text-muted">Repartidores</small></div>
      </div>
    </div>
  </div>
</div>

<!-- Earnings Chart -->
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap:8px">
    <div>
      <i class="fas fa-chart-line text-primary mr-1"></i>
      <span style="font-weight:600">Ganancias</span>
      <span id="totalEarnings" class="ml-2 badge badge-primary" style="font-size:12px">${esc(currency)}0.00</span>
    </div>
    <div class="d-flex flex-wrap" style="gap:6px">
      <button class="btn btn-sm btn-outline-primary filter-btn active" data-filter="week" onclick="loadChart('week')">7d</button>
      <button class="btn btn-sm btn-outline-primary filter-btn" data-filter="month" onclick="loadChart('month')">30d</button>
      <button class="btn btn-sm btn-outline-primary filter-btn" data-filter="custom" onclick="loadChart('custom')">Rango</button>
    </div>
  </div>
  <div class="card-body">
    <div id="customRange" style="display:none;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center">
      <input type="date" id="dateFrom" class="form-control form-control-sm" style="width:auto">
      <span class="text-muted">a</span>
      <input type="date" id="dateTo" class="form-control form-control-sm" style="width:auto">
      <button class="btn btn-sm btn-primary" onclick="loadChart('custom')"><i class="fas fa-search"></i></button>
    </div>
    <div class="chart-box">
      <canvas id="earningsChart"></canvas>
    </div>
  </div>
</div>

<!-- Quick Links -->
<div class="card mb-3">
  <div class="card-header"><i class="fas fa-bolt mr-1 text-orange" aria-hidden="true"></i> Accesos rápidos</div>
  <div class="card-body" style="padding:12px">
    <div class="row">
      <div class="col-4 col-md-2"><a href="/admin/orders" class="quick-link"><i class="fas fa-receipt"></i>Pedidos</a></div>
      <div class="col-4 col-md-2"><a href="/admin/stores" class="quick-link"><i class="fas fa-store"></i>Tiendas</a></div>
      <div class="col-4 col-md-2"><a href="/admin/items" class="quick-link"><i class="fas fa-utensils"></i>Items</a></div>
      <div class="col-4 col-md-2"><a href="/admin/delivery-guys" class="quick-link"><i class="fas fa-motorcycle"></i>Delivery</a></div>
      <div class="col-4 col-md-2"><a href="/admin/coupons" class="quick-link"><i class="fas fa-ticket-alt"></i>Cupones</a></div>
      <div class="col-4 col-md-2"><a href="/admin/settings" class="quick-link"><i class="fas fa-cog"></i>Settings</a></div>
    </div>
  </div>
</div>

<div class="row">
  <!-- Recent Orders -->
  <div class="col-lg-7 mb-3">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-receipt mr-1 text-primary"></i> Últimos pedidos</span>
        <a href="/admin/orders" class="btn btn-sm btn-outline-primary">Ver todos</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Cliente</th><th>Tienda</th><th>Total</th><th>Estado</th><th>Tiempo</th><th>Fecha</th></tr></thead>
            <tbody>
              ${(typeof recentOrders !== 'undefined' ? recentOrders : []).map(o => {
                const elapsed = elapsedFn(o.created_at, o.orderstatus_id, o.updated_at);
                const orderUrl = o.unique_order_id || o.id;
                return `
              <tr style="cursor:pointer" onclick="location.href='/admin/order/${esc(orderUrl)}'">
                <td><strong>${esc(o.unique_order_id || o.id)}</strong></td>
                <td>${esc(o.user_name || '-')}</td>
                <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(o.restaurant_name || '-')}</td>
                <td><strong>${esc(currency)}${esc(parseFloat(o.total||0).toFixed(2))}</strong></td>
                <td><span class="badge badge-${esc(({1:'info',2:'warning',3:'warning',4:'warning',5:'success',6:'danger',7:'success',8:'secondary',10:'purple',11:'info',12:'warning'})[o.orderstatus_id]||'secondary')}">${esc(({1:'Nuevo',2:'Aceptado',3:'En delivery',4:'En camino',5:'Entregado',6:'Cancelado',7:'Listo',8:'Pago pend.',10:'Programado',11:'Confirmado',12:'En preparación'})[o.orderstatus_id]||'-')}</span></td>
                <td><span class="text-nowrap" style="font-size:12px" data-order-elapsed data-created="${esc(o.created_at || '')}" data-status="${esc(o.orderstatus_id)}" data-updated="${esc(o.updated_at || '')}">${esc(elapsed)}</span></td>
                <td class="text-muted text-xs">${esc(new Date(o.created_at).toLocaleDateString('es',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}))}</td>
              </tr>`;
              }).join('')}
              ${(typeof recentOrders === 'undefined' || !recentOrders.length) ? '<tr><td colspan="7" class="text-center text-muted py-4">Sin pedidos</td></tr>' : ''}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column -->
  <div class="col-lg-5 mb-3">
    <!-- Top Stores -->
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-trophy mr-1 text-orange" aria-hidden="true"></i> Top tiendas</span>
        <a href="/admin/stores" class="btn btn-sm btn-outline-secondary">Ver</a>
      </div>
      <div class="card-body p-0">
        <div style="padding:0">
          ${(typeof topStores !== 'undefined' ? topStores : []).map((s, i) => `
          <div class="list-row">
            <span class="list-rank">${esc(i+1)}</span>
            <div style="flex:1;min-width:0">
              <div style="font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(s.name)}</div>
              <div class="text-muted text-xs">${esc(s.order_count)} pedidos</div>
            </div>
            <div style="text-align:right">
              <div class="text-success" style="font-size:13px;font-weight:600">${esc(currency)}${esc(parseFloat(s.revenue||0).toFixed(0))}</div>
              <span class="badge badge-${esc(s.is_active ? 'success' : 'danger')}" style="font-size:9px">${esc(s.is_active ? 'Abierto' : 'Cerrado')}</span>
            </div>
          </div>`).join('')}
          ${(typeof topStores === 'undefined' || !topStores.length) ? '<div class="text-center text-muted py-3" style="font-size:13px">Sin tiendas</div>' : ''}
        </div>
      </div>
    </div>

    <!-- Active Delivery -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-motorcycle mr-1 text-primary"></i> Repartidores activos</span>
        <a href="/admin/delivery-guys" class="btn btn-sm btn-outline-secondary">Ver</a>
      </div>
      <div class="card-body p-0">
        ${(typeof activeDelivery !== 'undefined' ? activeDelivery : []).map(d => `
        <div class="list-row">
          <div class="list-avatar" aria-hidden="true"><i class="fas fa-user"></i></div>
          <div style="flex:1;min-width:0">
            <div style="font-size:13px;font-weight:500">${esc(d.name)}</div>
            <div class="text-muted text-xs">${esc(d.phone || '')}</div>
          </div>
          <div>
            ${d.active_orders > 0 ? '<span class="badge badge-warning">'+d.active_orders+' en ruta</span>' : (d.is_live ? '<span class="badge badge-success">En línea</span>' : (d.has_location ? '<span class="badge badge-info">Con ubicación</span>' : '<span class="badge badge-secondary">Sin GPS</span>'))}
          </div>
        </div>`).join('')}
        ${(typeof activeDelivery === 'undefined' || !activeDelivery.length) ? '<div class="text-center text-muted py-3" style="font-size:13px">Sin repartidores activos</div>' : ''}
      </div>
    </div>
  </div>
</div>
`;
%>
<%- include('./layouts/master', { body, active, pageTitle, user: typeof user !== 'undefined' ? user : null, success: typeof success !== 'undefined' ? success : null, error: typeof error !== 'undefined' ? error : null, message: typeof message !== 'undefined' ? message : null, scripts, settings: typeof settings !== 'undefined' ? settings : {} }) %>
