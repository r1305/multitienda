<% var active = 'paymentmethods'; var pageTitle = 'Metodos de Pago'; %>
<% var scripts = ''; %>
<%
var mpInfo = (typeof mercadopago !== 'undefined' && mercadopago) ? mercadopago : { gateway: null, encryptionReady: false, fields: {}, webhookUrl: null };
var mpActive = !!(mpInfo.gateway && Number(mpInfo.gateway.is_active));
var mpField = function(key, label, help) {
  var f = (mpInfo.fields && mpInfo.fields[key]) || { saved: false, hint: null };
  var state = f.saved ? 'Guardado: ' + (f.hint || '') + ' (deja vacío para mantenerlo)' : 'Sin guardar';
  return `<div class="form-group">
      <label>${esc(label)}</label>
      <input type="password" name="${esc(key)}" class="form-control" autocomplete="new-password" spellcheck="false" placeholder="${esc(f.saved ? 'Pega un valor nuevo para reemplazarlo' : 'Pega el valor')}">
      <small class="form-text text-muted">${esc(state)}${help ? ' · ' + esc(help) : ''}</small>
    </div>`;
};
var body = `
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-credit-card"></i> Mercado Pago</span>
        <span class="badge badge-${esc(mpActive ? 'success' : 'secondary')}">${esc(mpActive ? 'Activo' : 'Inactivo')}</span>
    </div>
    <div class="card-body">
        ${mpInfo.encryptionReady ? '' : '<div class="alert alert-warning">Falta la variable de entorno <code>MP_ENCRYPTION_KEY</code> en el servidor: no se pueden guardar ni usar las credenciales.</div>'}
        <form method="POST" action="/admin/payment-method/mercadopago/save" autocomplete="off">
            ${mpField('access_token', 'Access Token (privado)', 'Credencial de producción de tu cuenta de Mercado Pago')}
            ${mpField('public_key', 'Public Key', '')}
            ${mpField('webhook_secret', 'Clave secreta de notificaciones (webhook)', 'Se usa para validar la firma x-signature')}
            <div class="form-group">
                <label>URL de notificaciones</label>
                <input type="text" class="form-control" readonly value="${esc(mpInfo.webhookUrl || 'Configura APP_URL en el servidor')}">
                <small class="form-text text-muted">Regístrala en Mercado Pago (Webhooks, evento Pagos).</small>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="mpActive" name="is_active" value="1" ${mpActive ? 'checked' : ''}>
                <label class="form-check-label" for="mpActive">Activo (requiere Access Token y Public Key guardados)</label>
            </div>
            <button type="submit" class="btn btn-primary">Guardar Mercado Pago</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Metodos de Pago</span>
        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#newPaymentModal"><i class="fas fa-plus"></i> Nuevo</button>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr><th>Nombre</th><th>Nro Cuenta</th><th>Nro Celular</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>`;

if (typeof gateways !== 'undefined' && gateways.length) {
  gateways.forEach(function(gw) {
    body += `<tr>
      <td><strong>${esc(gw.name)}</strong></td>
      <td>${esc(gw.account_number || '-')}</td>
      <td>${esc(gw.phone_number || '-')}</td>
      <td><span class="badge badge-${esc(gw.is_active ? 'success' : 'danger')}">${esc(gw.is_active ? 'Activo' : 'Inactivo')}</span></td>
      <td>
        <button class="btn btn-sm btn-outline-primary" data-toggle="modal" data-target="#editPay${esc(gw.id)}"><i class="fas fa-edit"></i></button>
        <form method="POST" action="/admin/payment-method/toggle/${esc(gw.id)}" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-warning"><i class="fas fa-power-off"></i></button></form>
        <form method="POST" action="/admin/payment-method/delete/${esc(gw.id)}" class="d-inline" onsubmit="return confirm('Eliminar?')"><button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form>
      </td>
    </tr>
    <div class="modal fade" id="editPay${esc(gw.id)}" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
      <form method="POST" action="/admin/payment-method/edit/save">
        <input type="hidden" name="id" value="${esc(gw.id)}">
        <div class="modal-header"><h5>Editar Metodo</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
        <div class="modal-body">
          <div class="form-group"><label>Nombre *</label><input type="text" name="name" class="form-control" value="${esc(gw.name)}" required></div>
          <div class="form-group"><label>Nro de Cuenta</label><input type="text" name="account_number" class="form-control" value="${esc(gw.account_number || '')}"></div>
          <div class="form-group"><label>Nro de Celular</label><input type="text" name="phone_number" class="form-control" value="${esc(gw.phone_number || '')}"></div>
        </div>
        <div class="modal-footer"><button type="submit" class="btn btn-primary">Guardar</button></div>
      </form>
    </div></div></div>`;
  });
} else {
  body += '<tr><td colspan="5" class="text-center text-muted py-4">Sin metodos de pago</td></tr>';
}

body += `</tbody></table></div></div>

<div class="modal fade" id="newPaymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/payment-method/new/save">
                <div class="modal-header"><h5>Nuevo Metodo de Pago</h5><button type="button" class="close" data-dismiss="modal">&times;</button></div>
                <div class="modal-body">
                    <div class="form-group"><label>Nombre *</label><input type="text" name="name" class="form-control" required placeholder="Ej: Yape, Plin, Transferencia"></div>
                    <div class="form-group"><label>Nro de Cuenta</label><input type="text" name="account_number" class="form-control" placeholder="Opcional"></div>
                    <div class="form-group"><label>Nro de Celular</label><input type="text" name="phone_number" class="form-control" placeholder="Opcional"></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-primary">Crear</button></div>
            </form>
        </div>
    </div>
</div>`;
%>
<%- include('./layouts/master', { body, active, pageTitle, user: typeof user !== 'undefined' ? user : null, success: typeof success !== 'undefined' ? success : null, error: typeof error !== 'undefined' ? error : null, message: typeof message !== 'undefined' ? message : null, scripts }) %>
