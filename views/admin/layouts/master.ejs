<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <title>Admin - Multitienda</title>
    <% const bp = (typeof appBase !== 'undefined' && appBase) ? appBase : ''; %>
    <% const favUrl = (typeof settings !== 'undefined' && settings && settings.faviconUrl) ? settings.faviconUrl : bp + '/assets/img/favicons/favicon-96x96.png'; %>
    <link rel="icon" type="image/png" href="<%= favUrl %>">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="<%= bp %>/assets/vendor/fontawesome-free-6.5.0-web/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="<%= bp %>/assets/css/admin-futuro.css">
    <script>
      (function() {
        var t = null;
        try { t = localStorage.getItem('adminTheme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
</head>
<body>
    <!-- Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar" aria-label="Menú de administración">
        <div class="sidebar-brand"><% if (settings && settings.logoUrl) { %><img src="<%= settings.logoUrl %>" height="28" alt=""><% } else { %><span class="brand-mark" aria-hidden="true"><i class="fas fa-store"></i></span><% } %><span>Multitienda<span class="brand-sub">Control center</span></span></div>
        <div class="sidebar-section">Principal</div>
        <a href="<%= bp %>/admin/dashboard" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="<%= bp %>/admin/orders" class="<%= typeof active !== 'undefined' && active === 'orders' ? 'active' : '' %>"><i class="fas fa-shopping-cart"></i> Pedidos</a>
        <a href="<%= bp %>/admin/stores" class="<%= typeof active !== 'undefined' && active === 'stores' ? 'active' : '' %>"><i class="fas fa-store"></i> Tiendas</a>
        <a href="<%= bp %>/admin/business-types" class="<%= typeof active !== 'undefined' && active === 'businesstypes' ? 'active' : '' %>"><i class="fas fa-tags"></i> Rubros</a>

        <div class="sidebar-section">Catálogo</div>
        <a href="<%= bp %>/admin/items" class="<%= typeof active !== 'undefined' && active === 'items' ? 'active' : '' %>"><i class="fas fa-utensils"></i> Items</a>
        <a href="<%= bp %>/admin/item-categories" class="<%= typeof active !== 'undefined' && active === 'itemcategories' ? 'active' : '' %>"><i class="fas fa-list"></i> Categorías</a>
        <a href="<%= bp %>/admin/addon-categories" class="<%= typeof active !== 'undefined' && active === 'addoncategories' ? 'active' : '' %>"><i class="fas fa-puzzle-piece"></i> Addons</a>

        <div class="sidebar-section">Usuarios</div>
        <a href="<%= bp %>/admin/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>"><i class="fas fa-users"></i> Usuarios</a>
        <a href="<%= bp %>/admin/delivery-guys" class="<%= typeof active !== 'undefined' && active === 'delivery' ? 'active' : '' %>"><i class="fas fa-motorcycle"></i> Repartidores</a>
        <a href="<%= bp %>/admin/cash-collections" class="<%= typeof active !== 'undefined' && active === 'cashcollections' ? 'active' : '' %>"><i class="fas fa-cash-register"></i> Caja repartidores</a>
        <a href="<%= bp %>/admin/store-owners" class="<%= typeof active !== 'undefined' && active === 'storeowners' ? 'active' : '' %>"><i class="fas fa-user-tie"></i> Dueños</a>

        <div class="sidebar-section">Marketing</div>
        <a href="<%= bp %>/admin/promo-sliders" class="<%= typeof active !== 'undefined' && active === 'sliders' ? 'active' : '' %>"><i class="fas fa-images"></i> Sliders</a>
        <a href="<%= bp %>/admin/coupons" class="<%= typeof active !== 'undefined' && active === 'coupons' ? 'active' : '' %>"><i class="fas fa-ticket-alt"></i> Cupones</a>
        <a href="<%= bp %>/admin/store-category-slider" class="<%= typeof active !== 'undefined' && active === 'categoryslider' ? 'active' : '' %>"><i class="fas fa-th-large"></i> Cat. Slider</a>

        <div class="sidebar-section">Configuración</div>
        <a href="<%= bp %>/admin/translations" class="<%= typeof active !== 'undefined' && active === 'translations' ? 'active' : '' %>"><i class="fas fa-language"></i> Idiomas</a>
        <a href="<%= bp %>/admin/notifications" class="<%= typeof active !== 'undefined' && active === 'notifications' ? 'active' : '' %>"><i class="fas fa-bell"></i> Notificaciones</a>
        <a href="<%= bp %>/admin/store-payouts" class="<%= typeof active !== 'undefined' && active === 'payouts' ? 'active' : '' %>"><i class="fas fa-money-bill"></i> Pagos</a>
        <a href="<%= bp %>/admin/payment-methods" class="<%= typeof active !== 'undefined' && active === 'paymentmethods' ? 'active' : '' %>"><i class="fas fa-credit-card"></i> Metodos de Pago</a>
        <a href="<%= bp %>/admin/settings" class="<%= typeof active !== 'undefined' && active === 'settings' ? 'active' : '' %>"><i class="fas fa-cog"></i> Settings</a>
        <hr>
        <form method="POST" action="<%= bp %>/auth/logout" class="logout-form"><button type="submit"><i class="fas fa-sign-out-alt"></i> Cerrar Sesión</button></form>
    </nav>

    <!-- Main -->
    <div class="main-content">
        <div class="top-bar">
            <div class="top-bar-left">
                <button type="button" class="hamburger" onclick="toggleSidebar()" aria-label="Abrir menú" aria-controls="sidebar"><i class="fas fa-bars" aria-hidden="true"></i></button>
                <h5><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin' %></h5>
            </div>
            <div class="top-bar-user">
                <button type="button" class="theme-toggle" id="themeToggle" onclick="toggleTheme()" title="Cambiar tema" aria-label="Cambiar tema"><i class="fas" id="themeIcon" aria-hidden="true"></i></button>
                <span><%= typeof user !== 'undefined' && user ? user.name : 'Admin' %></span>
                <div class="avatar" aria-hidden="true"><%= typeof user !== 'undefined' && user ? user.name[0].toUpperCase() : 'A' %></div>
            </div>
        </div>

        <main class="content-wrap">
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="close" data-dismiss="alert">&times;</button></div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="close" data-dismiss="alert">&times;</button></div>
            <% } %>
            <% if (typeof message !== 'undefined' && message) { %>
                <div class="alert alert-warning alert-dismissible fade show"><%= message %><button type="button" class="close" data-dismiss="alert">&times;</button></div>
            <% } %>

            <%- body %>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script>
      function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('open');
      }
      // Close sidebar on link click (mobile)
      document.querySelectorAll('.sidebar a').forEach(function(link) {
        link.addEventListener('click', function() {
          if (window.innerWidth < 992) toggleSidebar();
        });
      });
      // DataTables responsive defaults
      $.extend($.fn.dataTable.defaults, { responsive: true, language: { search: '', searchPlaceholder: 'Buscar...', lengthMenu: '_MENU_ por página', info: '_START_-_END_ de _TOTAL_', emptyTable: 'Sin resultados', zeroRecords: 'Ningún resultado coincide', paginate: { previous: '‹', next: '›' } } });
      window.initAdminListTable = function(selector, options) {
        var $table = $(selector);
        if (!$table.length) return null;
        if ($.fn.DataTable.isDataTable($table[0])) {
          $table.DataTable().destroy();
          $table.find('tbody tr').each(function() {
            $(this).children('td,th').each(function() {
              var idx = $(this).data('dt-column');
              if (idx !== undefined) $(this).removeData('dt-column');
            });
          });
        }
        var colCount = $table.find('thead th').length;
        $table.find('tbody tr').each(function() {
          var $tr = $(this);
          if ($tr.find('td[colspan]').length) return;
          var n = $tr.children('td').length;
          if (n > 0 && n !== colCount) {
            console.warn('DataTables: fila con', n, 'celdas, se esperaban', colCount, $tr[0]);
          }
        });
        return $table.DataTable($.extend(true, {
          responsive: true,
          pageLength: 25,
          dom: 'lrtip'
        }, options || {}));
      };
      window.wireAdminListSearch = function(inputSelector, tableSelector) {
        var $input = $(inputSelector);
        var $table = $(tableSelector);
        if (!$input.length || !$table.length) return;
        $input.on('keyup input', function() {
          var api = $table.DataTable();
          if (api) api.search(this.value).draw();
        });
      };
      /** Plain HTML table filter (no DataTables) — use when DT breaks on complex rows */
      window.wireAdminTableSearchSimple = function(inputSelector, tableSelector) {
        var $input = $(inputSelector);
        var $table = $(tableSelector);
        if (!$input.length || !$table.length) return;
        $input.on('keyup input', function() {
          var q = this.value.toLowerCase().trim();
          $table.find('tbody tr').each(function() {
            var text = $(this).text().toLowerCase();
            $(this).toggle(!q || text.indexOf(q) >= 0);
          });
        });
      };

      // Theme toggle
      function toggleTheme() {
        var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        try { localStorage.setItem('adminTheme', t); } catch (e) {}
        updateThemeIcon();
        document.dispatchEvent(new CustomEvent('admin:theme', { detail: t }));
      }
      function updateThemeIcon() {
        var icon = document.getElementById('themeIcon');
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (icon) icon.className = 'fas ' + (dark ? 'fa-sun' : 'fa-moon');
        var btn = document.getElementById('themeToggle');
        if (btn) { btn.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro'); btn.title = btn.getAttribute('aria-label'); }
      }
      window.adminChartTheme = function() {
        var cs = getComputedStyle(document.documentElement);
        var v = function(n) { return cs.getPropertyValue(n).trim(); };
        return { line: v('--chart-line'), fill: v('--chart-fill'), bar: v('--chart-bar'), barAlt: v('--chart-bar-alt'), barAltBorder: v('--chart-bar-alt-border'), grid: v('--chart-grid'), text: v('--chart-text') };
      };
      updateThemeIcon();

    </script>
    <script>
      // Auto-inject CSRF token into all POST forms
      (function() {
        var token = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
        if (!token) return;
        document.querySelectorAll('form').forEach(function(form) {
          var method = (form.method || 'GET').toUpperCase();
          if (method !== 'POST') return;
          // Avoid duplicate tokens
          if (form.querySelector('input[name="_csrf"]')) return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = '_csrf';
          input.value = token;
          form.appendChild(input);
        });
      })();
    </script>
    <% if (typeof scripts !== 'undefined') { %><%- scripts %><% } %>
</body>
</html>
