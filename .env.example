NODE_ENV=production
APP_PORT=3001
APP_URL=https://tudominio.com
APP_BASE_PATH=/multitienda
CORS_ORIGIN=https://tudominio.com

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_POOL_MAX=5
DB_POOL_MIN=0

JWT_SECRET=your-random-secret-key-here
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-here

# Redis (optional — only if Redis is installed on the server)
# REDIS_URL=redis://127.0.0.1:6379
# SESSION_STORE=redis

# cPanel without Redis (recommended):
SESSION_STORE=memory

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
FIREBASE_CREDENTIALS=./firebase-credentials.json
FIREBASE_VAPID_KEY=
# Respaldo: la URL y la credencial se configuran en Admin > Settings > Notifications (la BD tiene prioridad)
# Espejo de estados de pedido en Firebase Realtime Database (opcional; sin URL queda desactivado)
FIREBASE_DATABASE_URL=

# Performance tuning
BODY_LIMIT=2mb
SERVE_STATIC=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
CACHE_SETTINGS_TTL=300
CACHE_RESTAURANTS_TTL=120
CACHE_ADMIN_SETTINGS_TTL=300
CACHE_FIREBASE_CONFIG_TTL_MS=300000
GPS_MIN_INTERVAL_MS=30000
GPS_MIN_DISTANCE_KM=0.05
DELIVERY_ORDERS_LIMIT=50

# PM2: disable in-cluster notification processing (use worker app)
ENABLE_NOTIFICATION_WORKER=true

# SMTP (OTP y recuperacion de contrasena)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Licencia (verificada en el cliente; sin LICENSE_PUBLIC_KEY la app corre sin licencia salvo LICENSE_ENFORCE=true)
LICENSE_KEY=
LICENSE_SERVER_URL=
LICENSE_PUBLIC_KEY=
LICENSE_ENFORCE=
LICENSE_GRACE_DAYS=7
LICENSE_CHECK_TTL_MS=43200000
LICENSE_TIMEOUT_MS=8000
